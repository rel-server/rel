mutation roles
  create role "~anonymous";
  create role "~authenticated";

mutation api depends on roles
  create schema api;
  grant usage on schema api to "~authenticated";
  grant usage on schema api to "~anonymous";

mutation basic_tables depends on api

  CREATE TABLE api.items (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name TEXT NOT NULL
  );

  CREATE TABLE api.items_tags (
    item_id BIGINT REFERENCES api.items(id)
      ON DELETE CASCADE ON UPDATE CASCADE DEFERRABLE INITIALLY DEFERRED
    ,
    tag TEXT NOT NULL,
    PRIMARY KEY (item_id, tag)
  );

  CREATE TABLE api.groups (
    name TEXT NOT NULL PRIMARY KEY,
    description TEXT NOT NULL
  );

  CREATE TABLE api.users (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    name TEXT NOT NULL,
    group_name TEXT REFERENCES api.groups(name),
    email TEXT UNIQUE NOT NULL
  );

  CREATE TABLE api.reviews (
    id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
    title TEXT NOT NULL,
    review TEXT NOT NULL,
    rating DECIMAL(2,1), -- e.g. 8.5
    user_id BIGINT REFERENCES api.users(id) ON UPDATE CASCADE ON DELETE CASCADE,
    item_id BIGINT REFERENCES api.items(id) ON UPDATE CASCADE ON DELETE CASCADE,
    created_at TIMESTAMP WITH TIME ZONE DEFAULT CURRENT_TIMESTAMP
  );

  grant all on table api.users to "~anonymous";
  grant all on table api.groups to "~anonymous";
  grant all on table api.items to "~anonymous";
  grant all on table api.items_tags to "~anonymous";
  grant all on table api.reviews to "~anonymous";
